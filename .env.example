# ─────────────────────────────────────────────────
# Sanctuary AV Controller — Configuration
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All IP addresses should be static on your network.

# ── Server ────────────────────────────────────────
PORT=3000

# ── REAPER DAW (OSC) ─────────────────────────────
# Enable OSC in REAPER: Preferences > Control/OSC/web > Add
# Set "Mode" to "Configure device IP+local port"
# Set "Device IP" to this machine's IP
# Set "Device port" to REAPER_OSC_SEND_PORT (where Node listens)
# Set "Local listen port" to REAPER_OSC_RECEIVE_PORT (where REAPER listens)
REAPER_HOST=127.0.0.1
REAPER_OSC_SEND_PORT=9000
REAPER_OSC_RECEIVE_PORT=8000

# ── Blackmagic ATEM Mini Pro ──────────────────────
# Set a static IP on the ATEM via ATEM Software Control
ATEM_IP=192.168.1.240

# ── Soundcraft Si Impact ─────────────────────────
# Ping-only monitoring (no control API available)
# Set to the IP shown on the Soundcraft's network settings
SOUNDCRAFT_IP=192.168.1.100

# ── YouTube Data API v3 ──────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a project and enable "YouTube Data API v3"
# 3. Create OAuth 2.0 credentials (Desktop App type)
# 4. Fill in client ID and secret below
# 5. On first run, the server will print an auth URL —
#    visit it, grant access, paste the code back in terminal
# 6. The refresh token will be cached in .youtube-token.json
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# Optional: pre-fill if you know your video/stream IDs
# Leave blank to auto-detect active broadcast
YOUTUBE_VIDEO_ID=
YOUTUBE_STREAM_ID=

# ── Network ──────────────────────────────────────
GATEWAY_IP=192.168.1.1
YOUTUBE_INGEST_HOST=a.rtmp.youtube.com
